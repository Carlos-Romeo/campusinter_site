# CAMPUS INTER — Configuration Production
# Copiez ce fichier en .env et remplissez les valeurs

# Environnement
APP_ENV=production
APP_URL=https://campusinter-site.onrender.com
APP_DEBUG=false

# Base de données (automatiquement configuré sur Render avec Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusinter
DB_USER=campususer
DB_PASSWORD=campus123

# Email SMTP (configurer pour l'envoi d'emails)
MAIL_HOST=smtp.campusinter.com
MAIL_PORT=465
MAIL_USERNAME=webinfo@campusinter.com
MAIL_PASSWORD="adressederecueild'info///*"
MAIL_FROM=noreply@campusinter.com
MAIL_FROM_NAME=Campus Inter
MAIL_TO=webinfo@campusinter.com
MAIL_ENCRYPTION=tls

# Paiement Timoney (Mobile Money)
TIMONEY_API_KEY=votre-cle-api-timoney
TIMONEY_API_SECRET=votre-secret-api-timoney
TIMONEY_API_URL=https://api.timoney.com/v1

# Limites d'upload (en octets)
UPLOAD_MAX_SIZE=5242880

