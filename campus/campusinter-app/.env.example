# CAMPUS INTER — Configuration Production
# Copiez ce fichier en .env et remplissez les valeurs

# Environnement
APP_ENV=production
APP_URL=https://votre-site.infinityfree.com
APP_DEBUG=false

# Base de données InfinityFree
DB_HOST=if0_XXXXX.infinityfree.com
DB_PORT=3306
DB_NAME=if0_XXXXX_campusinter
DB_USER=if0_XXXXX
DB_PASSWORD=votre_mot_de_passe

# Email SMTP (optionnel — configurer si vous voulez l'envoi d'emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-app
MAIL_FROM=votre-email@gmail.com
MAIL_FROM_NAME=Campus Inter
MAIL_TO=admission@rabatam.ci.com
MAIL_ENCRYPTION=tls
